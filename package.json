  "license": "UNLICENSED",
  "homepage": "https://github.com/k4raga/schedule-widget#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k4raga/schedule-widget.git"
  },
  "bugs": {
    "url": "https://github.com/k4raga/schedule-widget/issues"
  },
  "main": "apps/desktop/main.js",
  "scripts": {
    "start": "electron ./apps/desktop/main.js",
